# =============================================================================
# NNT RAG - Backend Environment Configuration Template
# =============================================================================

# 1. Server & Networking
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# 2. Database Connection (Supabase PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:your_password@your_db_host:5432/postgres

# 3. Document Parsing (LlamaParse)
LLAMAPARSE_API_KEY=llx-your-llamaparse-api-key

# 4. Authentication & RBAC (JWT Configuration)
# Required in production with no insecure fallback allowed
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# 5. Text Embeddings (Vector Search)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/jina-embeddings-v2-small-en

# 6. LLM Generation (Answer Synthesis)
LLM_PROVIDER=ollama
# GROQ_API_KEY=gsk_your_groq_api_key
# GROQ_MODEL=qwen/qwen3.8-27b
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-flash-latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hf.co/unsloth/Qwen3.5-0.8B-GGUF:Q4_K_M

# 7. Ingestion Concurrency
INGESTION_CONCURRENCY=3
